premium  sql     │  WITH recent_injuries AS (
  SELECT 
    i.athlete_id,
    TRIM(a.first_name) || ' ' || TRIM(a.last_name) AS joueur,
    i.date_of_injury,
    i.recovery_date,
    i.context,
    i.mechanism,
    i.tissue,
    t_en.value AS injury_type,
    i.status,
    CASE 
      WHEN i.recovery_date IS NOT NULL AND i.recovery_date >= '2026-09-21'::date - INTERVAL '21 days' THEN 'recent_return'
      WHEN i.recovery_date IS NULL AND i.date_of_injury >= '2026-09-21'::date - INTERVAL '42 days' THEN 'ongoing'
      ELSE 'older'
    END AS rehab_phase
  FROM injuries i
  JOIN athletes a ON i.athlete_id = a.id
  LEFT JOIN injury_types it ON i.type_of_injury_id = it.id
  LEFT JOIN translations t_en ON t_en.translatable_id = it.id
    AND t_en.translatable_type = 'injury_type' 
    AND t_en.key = 'injury_type_name' 
    AND t_en.language = 'en'
  WHERE a.club_id = '019fa7cc-684c-783e-9609-c132a26eb4e3'
    AND (
      (i.recovery_date IS NOT NULL AND i.recovery_date >= '2026-09-21'::date - INTERVAL '21 days')
      OR (i.recovery_date IS NULL AND i.date_of_injury >= '2026-09-21'::date - INTERVAL '42 days')
    )
)
SELECT 
  joueur,
  date_of_injury,
  recovery_date,
  injury_type,
  tissue,
  mechanism,
  context,
  status,
  rehab_phase,
  CASE 
    WHEN recovery_date IS NOT NULL THEN (DATE '2026-10-04' - recovery_date)
    ELSE NULL
  END AS days_since_return
FROM recent_injuries
ORDER BY 
  CASE WHEN rehab_phase = 'recent_return' THEN 1 ELSE 2 END,
  recovery_date DESC NULLS LAST,
  date_of_injury DESC - column i.status does not exist
