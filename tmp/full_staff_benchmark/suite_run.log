sleep_week AS (
  SELECT 
    d.athlete_id,
    COUNT(DISTINCT d.date_of_day) AS n_sleep,
    ROUND(AVG(s.quality_rating), 1) AS sleep_quality_mean,
    ROUND(AVG(s.sleep_efficiency_percentage), 1) AS sleep_efficiency_mean,
    MIN(s.quality_rating) AS sleep_quality_min
  FROM sleeps s
  JOIN days d ON s.day_id = d.id
  JOIN athletes a ON d.athlete_id = a.id
  WHERE a.club_id = '019fa7cc-684c-783e-9609-c132a26eb4e3'
    AND d.date_of_day BETWEEN '2026-09-29' AND '2026-10-05'
  GROUP BY d.athlete_id
),
sleep_baseline AS (
  SELECT 
    d.athlete_id,
    ROUND(AVG(s.quality_rating), 1) AS sleep_quality_baseline,
    ROUND(AVG(s.sleep_efficiency_percentage), 1) AS sleep_efficiency_baseline
  FROM sleeps s
  JOIN days d ON s.day_id = d.id
  JOIN athletes a ON d.athlete_id = a.id
  WHERE a.club_id = '019fa7cc-684c-783e-9609-c132a26eb4e3'
    AND d.date_of_day BETWEEN '2026-09-01' AND '2026-09-28'
  GROUP BY d.athlete_id
),
gps_week AS (
  SELECT 
    a.id AS athlete_id,
    COUNT(DISTINCT ad.date_of_day) AS n_gps,
    ROUND(SUM(CAST(pmv.value AS DECIMAL)), 0) AS dsl_sum,
    ROUND(AVG(CAST(pmv.value AS DECIMAL)), 0) AS dsl_mean
  FROM period_metric_values pmv
  JOIN period_metrics pm ON pmv.metric_id = pm.id AND pm.name = 'kpi_dsl'
  JOIN periods p ON pmv.period_id = p.id
  JOIN sport_activities sa ON p.sport_activity_id = sa.id
  JOIN days ad ON sa.day_id = ad.id
  JOIN athletes a ON ad.athlete_id = a.id
  WHERE a.club_id = '019fa7cc-684c-783e-9609-c132a26eb4e3'
    AND ad.date_of_day BETWEEN '2026-09-29' AND '2026-10-05'
    AND (
      p.name ILIKE '%entire session%'
      OR NOT EXISTS (
        SELECT 1 FROM periods p2
        WHERE p2.sport_activity_id = p.sport_activity_id AND p2.name ILIKE '%entire session%'
      )
    )
  GROUP BY a.id
)
SELECT 
  ww.joueur,
  ww.n_wellness,
  sw.n_sleep,
  gw.n_gps,
  ww.soreness_mean,
  wb.soreness_baseline,
  ROUND(ww.soreness_mean - wb.soreness_baseline, 1) AS soreness_delta,
  ww.mood_mean,
  wb.mood_baseline,
  ROUND(ww.mood_mean - wb.mood_baseline, 1) AS mood_delta,
  ww.energy_mean,
  wb.energy_baseline,
  ROUND(ww.energy_mean - wb.energy_baseline, 1) AS energy_delta,
  sw.sleep_quality_mean,
  sb.sleep_quality_baseline,
  ROUND(sw.sleep_quality_mean - sb.sleep_quality_baseline, 1) AS sleep_quality_delta,
  sw.sleep_efficiency_mean,
  sb.sleep_efficiency_baseline,
  ROUND(sw.sleep_efficiency_mean - sb.sleep_efficiency_baseline, 1) AS sleep_efficiency_delta,
  gw.dsl_sum,
  gw.dsl_mean,
  ww.soreness_min,
  ww.mood_min,
  sw.sleep_quality_min
FROM wellness_week ww
LEFT JOIN wellness_baseline wb ON ww.athlete_id = wb.athlete_id
LEFT JOIN sleep_week sw ON ww.athlete_id = sw.athlete_id
LEFT JOIN sleep_baseline sb ON ww.athlete_id = sb.athlete_id
LEFT JOIN gps_week gw ON ww.athlete_id = gw.athlete_id
WHERE gw.dsl_sum IS NOT NULL
  AND gw.dsl_sum > 0
  AND (
    (ww.soreness_mean - wb.soreness_baseline) > 1.0
    OR (ww.mood_mean - wb.mood_baseline) < -1.0
    OR (ww.energy_mean - wb.energy_baseline) < -1.0
    OR (sw.sleep_quality_mean - sb.sleep_quality_baseline) < -1.0
    OR (sw.sleep_efficiency_mean - sb.sleep_efficiency_baseline) < -5.0
  )
ORDER BY 
  (ww.soreness_mean - wb.soreness_baseline) DESC,
  (ww.mood_mean - wb.mood_baseline) ASC,
  (sw.sleep_quality_mean - sb.sleep_quality_baseline) ASC
