premium  sql     │  WITH display_window AS (
  SELECT '2026-09-29'::date AS start_date, '2026-10-05'::date AS end_date
),
load_week AS (
  SELECT 
    d.athlete_id,
    TRIM(a.first_name) || ' ' || TRIM(a.last_name) AS joueur,
    COUNT(DISTINCT d.date_of_day) FILTER (WHERE hmv.value IS NOT NULL) AS n_rpe,
    ROUND(SUM(CAST(hmv.value AS DECIMAL)), 0) AS srpe_total,
    ROUND(AVG(CAST(hmv.value AS DECIMAL)), 1) AS srpe_mean, MAX(COALESCE((SELECT pmcu.unit FROM period_metric_club_units pmcu WHERE pmcu.metric_id = pm.id AND pmcu.club_id = a.club_id LIMIT 1), pm.unit)) AS unit
FROM days d
  JOIN athletes a ON a.id = d.athlete_id
  CROSS JOIN display_window dw
  LEFT JOIN health_ratings hr ON hr.day_id = d.id
  LEFT JOIN health_metric_values hmv ON hmv.health_id = hr.id
  LEFT JOIN health_metrics hm ON hm.id = hmv.metric_id AND hm.name = 'training_rpe'
  WHERE a.club_id = '019fa7cc-684c-783e-9609-c132a26eb4e3'
    AND d.date_of_day BETWEEN dw.start_date AND dw.end_date
  GROUP BY d.athlete_id, joueur
),
minutes_week AS (
  SELECT 
    d.athlete_id,
    COUNT(DISTINCT sa.id) AS n_sessions,
    ROUND(SUM(CAST(pmv.value AS DECIMAL)) / 60.0, 0) AS minutes_total
  FROM sport_activities sa
  JOIN days d ON d.id = sa.day_id
  JOIN athletes a ON a.id = d.athlete_id
  CROSS JOIN display_window dw
  JOIN periods p ON p.sport_activity_id = sa.id
  JOIN period_metric_values pmv ON pmv.period_id = p.id
  JOIN period_metrics pm ON pm.id = pmv.metric_id AND pm.name = 'kpi_totalTime'
  WHERE a.club_id = '019fa7cc-684c-783e-9609-c132a26eb4e3'
    AND d.date_of_day BETWEEN dw.start_date AND dw.end_date
    AND (p.name ILIKE '%entire session%' OR NOT EXISTS (
      SELECT 1 FROM periods p2 WHERE p2.sport_activity_id = p.sport_activity_id AND p2.name ILIKE '%entire session%'
    ))
  GROUP BY d.athlete_id
),
wellness_week AS (
  SELECT 
    d.athlete_id,
    COUNT(DISTINCT d.date_of_day) FILTER (WHERE hr.body_soreness_rating IS NOT NULL) AS n_wellness,
    ROUND(AVG(hr.body_soreness_rating), 1) AS body_soreness_mean,
    ROUND(AVG(hr.energy_rating), 1) AS energy_mean,
    ROUND(AVG(hr.mood_rating), 1) AS mood_mean,
    ROUND(AVG(hr.stress_rating), 1) AS stress_mean
  FROM days d
  JOIN athletes a ON a.id = d.athlete_id
  CROSS JOIN display_window dw
  LEFT JOIN health_ratings hr ON hr.day_id = d.id
  WHERE a.club_id = '019fa7cc-684c-783e-9609-c132a26eb4e3'
    AND d.date_of_day BETWEEN dw.start_date AND dw.end_date
  GROUP BY d.athlete_id
),
sleep_week AS (
  SELECT 
    d.athlete_id,
    COUNT(DISTINCT d.date_of_day) FILTER (WHERE s.quality_rating IS NOT NULL) AS n_sleep,
    ROUND(AVG(s.quality_rating), 1) AS quality_mean,
    ROUND(AVG(s.sleep_efficiency_percentage), 1) AS efficiency_mean
  FROM days d
  JOIN athletes a ON a.id = d.athlete_id
  CROSS JOIN display_window dw
  LEFT JOIN sleeps s ON s.day_id = d.id
  WHERE a.club_id = '019fa7cc-684c-783e-9609-c132a26eb4e3'
    AND d.date_of_day BETWEEN dw.start_date AND dw.end_date
  GROUP BY d.athlete_id
)
SELECT 
  lw.joueur,
  lw.n_rpe,
  lw.srpe_total,
  lw.srpe_mean,
  COALESCE(mw.n_sessions, 0) AS n_sessions,
  COALESCE(mw.minutes_total, 0) AS minutes_total,
  ww.n_wellness,
  ww.body_soreness_mean,
  ww.energy_mean,
  ww.mood_mean,
  ww.stress_mean,
  sw.n_sleep,
  sw.quality_mean,
  sw.efficiency_mean
FROM load_week lw
LEFT JOIN minutes_week mw ON mw.athlete_id = lw.athlete_id
LEFT JOIN wellness_week ww ON ww.athlete_id = lw.athlete_id
LEFT JOIN sleep_week sw ON sw.athlete_id = lw.athlete_id
WHERE lw.n_rpe > 0 OR COALESCE(mw.n_sessions, 0) > 0 OR ww.n_wellness > 0
ORDER BY lw.srpe_total DESC NULLS LAST, mw.minutes_total DESC NULLS LAST - missing FROM-clause entry for table "pm"
