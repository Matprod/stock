premium  sql     │  WITH display_week AS (
  SELECT 
    a.id AS athlete_id,
    TRIM(a.first_name || ' ' || a.last_name) AS joueur,
    d.date_of_day,
    COALESCE(pmcu_dist.unit, pm_dist.unit) AS dist_unit,
    COALESCE(pmcu_hsr.unit, pm_hsr.unit) AS hsr_unit,
    SUM(CASE WHEN pm.name = 'kpi_distanceTotal' THEN CAST(pmv.value AS DECIMAL) ELSE 0 END) AS distance_m,
    SUM(CASE WHEN pm.name = 'kpi_highSpeedRunningAbs' THEN CAST(pmv.value AS DECIMAL) ELSE 0 END) AS hsr_m
  FROM athletes a
  JOIN days d ON d.athlete_id = a.id
  JOIN sport_activities sa ON sa.day_id = d.id
  JOIN periods p ON p.sport_activity_id = sa.id
  JOIN period_metric_values pmv ON pmv.period_id = p.id
  JOIN period_metrics pm ON pm.id = pmv.metric_id
  LEFT JOIN period_metric_club_units pmcu_dist ON pmcu_dist.metric_id = pm.id AND pmcu_dist.club_id = a.club_id AND pm.name = 'kpi_distanceTotal'
  LEFT JOIN period_metric_club_units pmcu_hsr ON pmcu_hsr.metric_id = pm.id AND pmcu_hsr.club_id = a.club_id AND pm.name = 'kpi_highSpeedRunningAbs'
  WHERE a.club_id = '019fa7cc-684c-783e-9609-c132a26eb4e3'
    AND d.date_of_day BETWEEN '2026-09-29' AND '2026-10-05'
    AND pm.name IN ('kpi_distanceTotal', 'kpi_highSpeedRunningAbs')
    AND (
      p.name ILIKE '%entire session%'
      OR NOT EXISTS (
        SELECT 1 FROM periods p2 
        WHERE p2.sport_activity_id = p.sport_activity_id 
          AND p2.name ILIKE '%entire session%'
      )
    )
  GROUP BY a.id, joueur, d.date_of_day, pmcu_dist.unit, pm_dist.unit, pmcu_hsr.unit, pm_hsr.unit
)
SELECT 
  joueur,
  SUM(distance_m) AS distance_total_m,
  SUM(hsr_m) AS hsr_total_m,
  MAX(dist_unit) AS dist_unit,
  MAX(hsr_unit) AS hsr_unit
FROM display_week
GROUP BY joueur
ORDER BY distance_total_m DESC NULLS LAST
