premium  sql     │  WITH target_athletes AS (
  SELECT id, TRIM(first_name || ' ' || last_name) AS joueur, MAX(COALESCE((SELECT pmcu.unit FROM period_metric_club_units pmcu WHERE pmcu.metric_id = pm.id AND pmcu.club_id = a.club_id LIMIT 1), pm.unit)) AS unit
FROM athletes
  WHERE club_id = '019fa7cc-684c-783e-9609-c132a26eb4e3'
    AND TRIM(first_name || ' ' || last_name) IN ('Miro Muheim', 'Alexander Røssing-Lelesiit', 'Fábio Vieira')
),
daily_gps AS (
  SELECT 
    ad.date_of_day,
    ta.joueur,
    SUM(CAST(pmv.value AS DECIMAL)) FILTER (WHERE pm.name = 'kpi_hmld') AS hmld_daily,
    SUM(CAST(pmv.value AS DECIMAL)) FILTER (WHERE pm.name = 'kpi_highSpeedRunningAbs') AS hsr_daily,
