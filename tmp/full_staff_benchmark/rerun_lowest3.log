premium  sql     │  WITH gps_week AS (
  SELECT 
    ad.athlete_id,
    TRIM(a.first_name || ' ' || a.last_name) AS joueur,
    SUM(CAST(pmv.value AS DECIMAL)) FILTER (WHERE pm.name = 'kpi_distanceTotal') AS total_distance,
    SUM(CAST(pmv.value AS DECIMAL)) FILTER (WHERE pm.name = 'kpi_hmld') AS total_hmld,
    SUM(CAST(pmv.value AS DECIMAL)) FILTER (WHERE pm.name = 'kpi_highSpeedRunningAbs') AS total_hsr,
    SUM(CAST(pmv.value AS DECIMAL)) FILTER (WHERE pm.name = 'kpi_sprintDistance') AS total_sprint_dist,
    SUM(CAST(pmv.value AS DECIMAL)) FILTER (WHERE pm.name = 'kpi_accelerationsRel') AS total_accel,
    SUM(CAST(pmv.value AS DECIMAL)) FILTER (WHERE pm.name = 'kpi_decelerationsRel') AS total_decel,
    MAX(CAST(pmv.value AS DECIMAL)) FILTER (WHERE pm.name = 'kpi_maxSpeed') AS max_speed,
    COUNT(DISTINCT ad.date_of_day) AS n_sessions, MAX(COALESCE((SELECT pmcu.unit FROM period_metric_club_units pmcu WHERE pmcu.metric_id = pm.id AND pmcu.club_id = a.club_id LIMIT 1), pm.unit)) AS unit
FROM period_metric_values pmv
  JOIN period_metrics pm ON pmv.metric_id = pm.id
  JOIN periods p ON pmv.period_id = p.id
  JOIN sport_activities sa ON p.sport_activity_id = sa.id
  JOIN days ad ON sa.day_id = ad.id
  JOIN athletes a ON ad.athlete_id = a.id
  WHERE a.club_id = '019fa7cc-684c-783e-9609-c132a26eb4e3'
    AND ad.date_of_day BETWEEN '2026-09-29' AND '2026-10-05'
    AND pm.name IN ('kpi_distanceTotal', 'kpi_hmld', 'kpi_highSpeedRunningAbs', 'kpi_sprintDistance', 
                    'kpi_accelerationsRel', 'kpi_decelerationsRel', 'kpi_maxSpeed')
    AND (
      p.name ILIKE '%entire session%'
      OR NOT EXISTS (
        SELECT 1 FROM periods p2
        WHERE p2.sport_activity_id = p.sport_activity_id AND p2.name ILIKE '%entire session%'
      )
    )
  GROUP BY ad.athlete_id, TRIM(a.first_name || ' ' || a.last_name)
  HAVING COUNT(DISTINCT ad.date_of_day) > 0
),
wellness_week AS (
  SELECT 
    ad.athlete_id,
    TRIM(a.first_name || ' ' || a.last_name) AS joueur,
    ROUND(AVG(hr.body_soreness_rating), 1) AS avg_soreness,
    ROUND(AVG(hr.energy_rating), 1) AS avg_energy,
    ROUND(AVG(hr.mood_rating), 1) AS avg_mood,
    ROUND(AVG(hr.stress_rating), 1) AS avg_stress,
    COUNT(DISTINCT ad.date_of_day) AS n_wellness
  FROM health_ratings hr
  JOIN days ad ON hr.day_id = ad.id
  JOIN athletes a ON ad.athlete_id = a.id
  WHERE a.club_id = '019fa7cc-684c-783e-9609-c132a26eb4e3'
    AND ad.date_of_day BETWEEN '2026-09-29' AND '2026-10-05'
  GROUP BY ad.athlete_id, TRIM(a.first_name || ' ' || a.last_name)
),
sleep_week AS (
  SELECT 
    ad.athlete_id,
    TRIM(a.first_name || ' ' || a.last_name) AS joueur,
    ROUND(AVG(s.quality_rating), 1) AS avg_sleep_quality,
    ROUND(AVG(s.sleep_efficiency_percentage), 1) AS avg_sleep_efficiency,
    ROUND(AVG(s.total_in_bed_time_milli / 3600000.0), 1) AS avg_hours_in_bed,
    COUNT(DISTINCT ad.date_of_day) AS n_sleep
  FROM sleeps s
  JOIN days ad ON s.day_id = ad.id
  JOIN athletes a ON ad.athlete_id = a.id
  WHERE a.club_id = '019fa7cc-684c-783e-9609-c132a26eb4e3'
    AND ad.date_of_day BETWEEN '2026-09-29' AND '2026-10-05'
  GROUP BY ad.athlete_id, TRIM(a.first_name || ' ' || a.last_name)
),
baseline_gps AS (
  SELECT 
    ad.athlete_id,
    AVG(CAST(pmv.value AS DECIMAL)) FILTER (WHERE pm.name = 'kpi_distanceTotal') AS baseline_distance,
    AVG(CAST(pmv.value AS DECIMAL)) FILTER (WHERE pm.name = 'kpi_hmld') AS baseline_hmld,
    AVG(CAST(pmv.value AS DECIMAL)) FILTER (WHERE pm.name = 'kpi_highSpeedRunningAbs') AS baseline_hsr,
    AVG(CAST(pmv.value AS DECIMAL)) FILTER (WHERE pm.name = 'kpi_accelerationsRel') AS baseline_accel
  FROM period_metric_values pmv
  JOIN period_metrics pm ON pmv.metric_id = pm.id
  JOIN periods p ON pmv.period_id = p.id
  JOIN sport_activities sa ON p.sport_activity_id = sa.id
  JOIN days ad ON sa.day_id = ad.id
  JOIN athletes a ON ad.athlete_id = a.id
  WHERE a.club_id = '019fa7cc-684c-783e-9609-c132a26eb4e3'
    AND ad.date_of_day BETWEEN '2026-09-01' AND '2026-09-28'
    AND pm.name IN ('kpi_distanceTotal', 'kpi_hmld', 'kpi_highSpeedRunningAbs', 'kpi_accelerationsRel')
    AND (
      p.name ILIKE '%entire session%'
      OR NOT EXISTS (
        SELECT 1 FROM periods p2
        WHERE p2.sport_activity_id = p.sport_activity_id AND p2.name ILIKE '%entire session%'
      )
    )
  GROUP BY ad.athlete_id
),
baseline_wellness AS (
  SELECT 
    ad.athlete_id,
    AVG(hr.body_soreness_rating) AS baseline_soreness,
    AVG(hr.energy_rating) AS baseline_energy,
    AVG(hr.mood_rating) AS baseline_mood
  FROM health_ratings hr
  JOIN days ad ON hr.day_id = ad.id
  JOIN athletes a ON ad.athlete_id = a.id
  WHERE a.club_id = '019fa7cc-684c-783e-9609-c132a26eb4e3'
    AND ad.date_of_day BETWEEN '2026-09-01' AND '2026-09-28'
  GROUP BY ad.athlete_id
),
baseline_sleep AS (
  SELECT 
    ad.athlete_id,
    AVG(s.quality_rating) AS baseline_sleep_quality,
    AVG(s.sleep_efficiency_percentage) AS baseline_sleep_efficiency
  FROM sleeps s
  JOIN days ad ON s.day_id = ad.id
  JOIN athletes a ON ad.athlete_id = a.id
  WHERE a.club_id = '019fa7cc-684c-783e-9609-c132a26eb4e3'
    AND ad.date_of_day BETWEEN '2026-09-01' AND '2026-09-28'
  GROUP BY ad.athlete_id
)
SELECT 
  g.joueur,
  g.n_sessions,
  ROUND(g.total_distance, 0) AS total_distance_m,
  ROUND(g.total_hmld, 0) AS total_hmld_m,
  ROUND(g.total_hsr, 0) AS total_hsr_m,
  ROUND(g.total_sprint_dist, 0) AS total_sprint_m,
  ROUND(g.total_accel, 0) AS total_accel,
  ROUND(g.total_decel, 0) AS total_decel,
  ROUND(g.max_speed, 1) AS max_speed_kmh,
  ROUND(((g.total_distance / NULLIF(bg.baseline_distance, 0) - 1) * 100), 0) AS distance_vs_baseline_pct,
  ROUND(((g.total_hmld / NULLIF(bg.baseline_hmld, 0) - 1) * 100), 0) AS hmld_vs_baseline_pct,
  ROUND(((g.total_hsr / NULLIF(bg.baseline_hsr, 0) - 1) * 100), 0) AS hsr_vs_baseline_pct,
  ROUND(((g.total_accel / NULLIF(bg.baseline_accel, 0) - 1) * 100), 0) AS accel_vs_baseline_pct,
  w.avg_soreness,
  w.avg_energy,
  w.avg_mood,
  w.avg_stress,
  w.n_wellness,
  ROUND((w.avg_soreness - bw.baseline_soreness), 1) AS soreness_delta,
  ROUND((w.avg_energy - bw.baseline_energy), 1) AS energy_delta,
  ROUND((w.avg_mood - bw.baseline_mood), 1) AS mood_delta,
  sl.avg_sleep_quality,
  sl.avg_sleep_efficiency,
  sl.avg_hours_in_bed,
  sl.n_sleep,
  ROUND((sl.avg_sleep_quality - bs.baseline_sleep_quality), 1) AS sleep_quality_delta,
  ROUND((sl.avg_sleep_efficiency - bs.baseline_sleep_efficiency), 1) AS sleep_efficiency_delta
FROM gps_week g
LEFT JOIN wellness_week w ON g.athlete_id = w.athlete_id
LEFT JOIN sleep_week sl ON g.athlete_id = sl.athlete_id
LEFT JOIN baseline_gps bg ON g.athlete_id = bg.athlete_id
LEFT JOIN baseline_wellness bw ON g.athlete_id = bw.athlete_id
LEFT JOIN baseline_sleep bs ON g.athlete_id = bs.athlete_id
WHERE (
  (w.avg_soreness IS NOT NULL AND bw.baseline_soreness IS NOT NULL AND (w.avg_soreness - bw.baseline_soreness) > 3)
  OR (w.avg_energy IS NOT NULL AND bw.baseline_energy IS NOT NULL AND (w.avg_energy - bw.baseline_energy) < -3)
  OR (w.avg_mood IS NOT NULL AND bw.baseline_mood IS NOT NULL AND (w.avg_mood - bw.baseline_mood) < -3)
  OR (sl.avg_sleep_quality IS NOT NULL AND bs.baseline_sleep_quality IS NOT NULL AND (sl.avg_sleep_quality - bs.baseline_sleep_quality) < -3)
  OR (sl.avg_sleep_efficiency IS NOT NULL AND bs.baseline_sleep_efficiency IS NOT NULL AND (sl.avg_sleep_efficiency - bs.baseline_sleep_efficiency) < -5)
)
AND (
  (g.total_hmld / NULLIF(bg.baseline_hmld, 0) > 1.15)
  OR (g.total_hsr / NULLIF(bg.baseline_hsr, 0) > 1.15)
  OR (g.total_accel / NULLIF(bg.baseline_accel, 0) > 1.15)
)
ORDER BY 
  COALESCE((g.total_hmld / NULLIF(bg.baseline_hmld, 0)), 0) DESC,
  COALESCE((w.avg_soreness - bw.baseline_soreness), 0) DESC
