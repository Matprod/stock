premium  sql     │  WITH wellness_week AS (
  SELECT 
    a.id AS athlete_id,
    TRIM(a.first_name || ' ' || a.last_name) AS joueur,
    ad.date_of_day,
    hr.body_soreness_rating,
    hr.mood_rating,
    hr.energy_rating,
    hr.stress_rating
  FROM athletes a
  JOIN days ad ON ad.athlete_id = a.id
  JOIN health_ratings hr ON hr.day_id = ad.id
  WHERE a.club_id = '019fa7cc-684c-783e-9609-c132a26eb4e3'
    AND ad.date_of_day BETWEEN '2026-09-29' AND '2026-10-05'
),
sleep_week AS (
  SELECT 
    a.id AS athlete_id,
    TRIM(a.first_name || ' ' || a.last_name) AS joueur,
    ad.date_of_day,
    s.quality_rating,
    s.sleep_efficiency_percentage
  FROM athletes a
  JOIN days ad ON ad.athlete_id = a.id
  JOIN sleeps s ON s.day_id = ad.id
  WHERE a.club_id = '019fa7cc-684c-783e-9609-c132a26eb4e3'
    AND ad.date_of_day BETWEEN '2026-09-29' AND '2026-10-05'
),
gps_load AS (
  SELECT 
    TRIM(a.first_name || ' ' || a.last_name) AS joueur,
    COUNT(DISTINCT ad.date_of_day) AS n_sessions
  FROM athletes a
  JOIN days ad ON ad.athlete_id = a.id
  JOIN sport_activities sa ON sa.day_id = ad.id
  WHERE a.club_id = '019fa7cc-684c-783e-9609-c132a26eb4e3'
    AND ad.date_of_day BETWEEN '2026-09-29' AND '2026-10-05'
  GROUP BY joueur
),
wellness_agg AS (
  SELECT 
    joueur,
    MIN(body_soreness_rating) AS min_soreness,
    MAX(body_soreness_rating) AS max_soreness,
    AVG(body_soreness_rating) AS avg_soreness,
    MIN(mood_rating) AS min_mood,
    MAX(mood_rating) AS max_mood,
    AVG(mood_rating) AS avg_mood,
    MIN(energy_rating) AS min_energy,
    MAX(energy_rating) AS max_energy,
    AVG(energy_rating) AS avg_energy,
    MAX(body_soreness_rating) - MIN(body_soreness_rating) AS soreness_range,
    MAX(mood_rating) - MIN(mood_rating) AS mood_range,
    MAX(energy_rating) - MIN(energy_rating) AS energy_range,
    COUNT(*) AS n_wellness
  FROM wellness_week
  GROUP BY joueur
),
sleep_agg AS (
  SELECT 
    joueur,
    MIN(quality_rating) AS min_sleep,
    MAX(quality_rating) AS max_sleep,
    AVG(quality_rating) AS avg_sleep,
    AVG(sleep_efficiency_percentage) AS avg_efficiency,
    MAX(quality_rating) - MIN(quality_rating) AS sleep_range,
    COUNT(*) AS n_sleep
  FROM sleep_week
  GROUP BY joueur
)
SELECT 
  w.joueur,
  g.n_sessions,
  w.n_wellness,
  s.n_sleep,
  ROUND(w.avg_soreness, 1) AS avg_soreness,
  ROUND(w.min_soreness, 1) AS min_soreness,
  ROUND(w.soreness_range, 1) AS soreness_range,
  ROUND(w.avg_mood, 1) AS avg_mood,
  ROUND(w.min_mood, 1) AS min_mood,
  ROUND(w.mood_range, 1) AS mood_range,
  ROUND(w.avg_energy, 1) AS avg_energy,
  ROUND(w.min_energy, 1) AS min_energy,
  ROUND(w.energy_range, 1) AS energy_range,
  ROUND(s.avg_sleep, 1) AS avg_sleep,
  ROUND(s.min_sleep, 1) AS min_sleep,
  ROUND(s.sleep_range, 1) AS sleep_range,
  ROUND(s.avg_efficiency, 1) AS avg_efficiency,
  ROUND(w.soreness_range + w.mood_range + w.energy_range + COALESCE(s.sleep_range, 0), 1) AS total_variability
FROM wellness_agg w
LEFT JOIN sleep_agg s ON w.joueur = s.joueur
LEFT JOIN gps_load g ON w.joueur = g.joueur
WHERE g.n_sessions >= 3
  AND (w.min_soreness <= 30 OR w.min_mood <= 30 OR w.min_energy <= 30 OR s.min_sleep <= 30)
ORDER BY total_variability DESC, w.min_soreness ASC
