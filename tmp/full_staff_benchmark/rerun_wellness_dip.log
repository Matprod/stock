premium  sql     │  WITH wellness_week AS (
  SELECT 
    d.athlete_id,
    TRIM(a.first_name || ' ' || a.last_name) AS joueur,
    COUNT(DISTINCT d.date_of_day) AS n_wellness,
    ROUND(AVG(hr.body_soreness_rating), 1) AS body_soreness_rating,
    ROUND(AVG(hr.energy_rating), 1) AS energy_rating,
    ROUND(AVG(hr.mood_rating), 1) AS mood_rating,
    ROUND(AVG(hr.stress_rating), 1) AS stress_rating, MAX(COALESCE((SELECT pmcu.unit FROM period_metric_club_units pmcu WHERE pmcu.metric_id = pm.id AND pmcu.club_id = a.club_id LIMIT 1), pm.unit)) AS unit
FROM health_ratings hr
  JOIN days d ON hr.day_id = d.id
  JOIN athletes a ON d.athlete_id = a.id
  WHERE a.club_id = '019fa7cc-684c-783e-9609-c132a26eb4e3'
    AND d.date_of_day BETWEEN '2026-09-29' AND '2026-10-05'
  GROUP BY d.athlete_id, joueur
),
wellness_baseline AS (
  SELECT 
    d.athlete_id,
    ROUND(AVG(hr.body_soreness_rating), 1) AS body_soreness_baseline,
    ROUND(AVG(hr.energy_rating), 1) AS energy_baseline,
    ROUND(AVG(hr.mood_rating), 1) AS mood_baseline,
    ROUND(AVG(hr.stress_rating), 1) AS stress_baseline
  FROM health_ratings hr
  JOIN days d ON hr.day_id = d.id
  JOIN athletes a ON d.athlete_id = a.id
  WHERE a.club_id = '019fa7cc-684c-783e-9609-c132a26eb4e3'
    AND d.date_of_day BETWEEN '2026-09-01' AND '2026-09-28'
  GROUP BY d.athlete_id
),
sleep_week AS (
  SELECT 
    d.athlete_id,
    COUNT(DISTINCT d.date_of_day) AS n_sleep,
    ROUND(AVG(s.quality_rating), 1) AS quality_rating,
    ROUND(AVG(s.sleep_efficiency_percentage), 1) AS sleep_efficiency
  FROM sleeps s
  JOIN days d ON s.day_id = d.id
  JOIN athletes a ON d.athlete_id = a.id
  WHERE a.club_id = '019fa7cc-684c-783e-9609-c132a26eb4e3'
    AND d.date_of_day BETWEEN '2026-09-29' AND '2026-10-05'
  GROUP BY d.athlete_id
),
sleep_baseline AS (
  SELECT 
    d.athlete_id,
    ROUND(AVG(s.quality_rating), 1) AS quality_baseline,
    ROUND(AVG(s.sleep_efficiency_percentage), 1) AS efficiency_baseline
  FROM sleeps s
  JOIN days d ON s.day_id = d.id
  JOIN athletes a ON d.athlete_id = a.id
  WHERE a.club_id = '019fa7cc-684c-783e-9609-c132a26eb4e3'
    AND d.date_of_day BETWEEN '2026-09-01' AND '2026-09-28'
  GROUP BY d.athlete_id
),
gps_week AS (
  SELECT 
    d.athlete_id,
    COUNT(DISTINCT d.date_of_day) AS n_gps,
    ROUND(SUM(CAST(pmv.value AS DECIMAL)), 0) AS dsl_sum,
    ROUND(AVG(CAST(pmv.value AS DECIMAL)), 0) AS dsl_mean
  FROM period_metric_values pmv
  JOIN period_metrics pm ON pmv.metric_id = pm.id AND pm.name = 'kpi_dsl'
  JOIN periods p ON pmv.period_id = p.id
  JOIN sport_activities sa ON p.sport_activity_id = sa.id
  JOIN days d ON sa.day_id = d.id
  JOIN athletes a ON d.athlete_id = a.id
  WHERE a.club_id = '019fa7cc-684c-783e-9609-c132a26eb4e3'
    AND d.date_of_day BETWEEN '2026-09-29' AND '2026-10-05'
    AND (
      p.name ILIKE '%entire session%'
      OR NOT EXISTS (
        SELECT 1 FROM periods p2
        WHERE p2.sport_activity_id = p.sport_activity_id AND p2.name ILIKE '%entire session%'
      )
    )
  GROUP BY d.athlete_id
)
SELECT 
  ww.joueur,
  ww.n_wellness,
  sw.n_sleep,
  gw.n_gps,
  ww.body_soreness_rating,
  wb.body_soreness_baseline,
  ROUND(ww.body_soreness_rating - wb.body_soreness_baseline, 1) AS soreness_delta,
  ww.energy_rating,
  wb.energy_baseline,
  ROUND(ww.energy_rating - wb.energy_baseline, 1) AS energy_delta,
  ww.mood_rating,
  wb.mood_baseline,
  ROUND(ww.mood_rating - wb.mood_baseline, 1) AS mood_delta,
  sw.quality_rating,
  sb.quality_baseline,
  ROUND(sw.quality_rating - sb.quality_baseline, 1) AS quality_delta,
  sw.sleep_efficiency,
  sb.efficiency_baseline,
  ROUND(sw.sleep_efficiency - sb.efficiency_baseline, 1) AS efficiency_delta,
  gw.dsl_sum,
  gw.dsl_mean
FROM wellness_week ww
LEFT JOIN wellness_baseline wb ON ww.athlete_id = wb.athlete_id
LEFT JOIN sleep_week sw ON ww.athlete_id = sw.athlete_id
LEFT JOIN sleep_baseline sb ON ww.athlete_id = sb.athlete_id
LEFT JOIN gps_week gw ON ww.athlete_id = gw.athlete_id
WHERE gw.dsl_sum IS NOT NULL
  AND gw.dsl_sum > 0
ORDER BY 
  (COALESCE(ww.body_soreness_rating - wb.body_soreness_baseline, 0) + 
   COALESCE(ww.energy_rating - wb.energy_baseline, 0) + 
   COALESCE(ww.mood_rating - wb.mood_baseline, 0) +
   COALESCE(sw.quality_rating - sb.quality_baseline, 0)) ASC
