premium  sql     │  WITH display_window AS (
  SELECT '2026-09-29'::date AS start_date, '2026-10-05'::date AS end_date
),
gps_player AS (
  SELECT 
    a.id AS athlete_id,
    TRIM(a.first_name || ' ' || a.last_name) AS joueur,
    COUNT(DISTINCT d.date_of_day) AS n_sessions,
    ROUND(AVG(CAST(pmv.value AS DECIMAL)) FILTER (WHERE pm.name = 'kpi_distanceTotal'), 0) AS avg_distance,
    ROUND(AVG(CAST(pmv.value AS DECIMAL)) FILTER (WHERE pm.name = 'kpi_hmld'), 0) AS avg_hmld,
    ROUND(AVG(CAST(pmv.value AS DECIMAL)) FILTER (WHERE pm.name = 'kpi_highSpeedRunningAbs'), 0) AS avg_hsr,
    ROUND(AVG(CAST(pmv.value AS DECIMAL)) FILTER (WHERE pm.name = 'kpi_sprintDistance'), 0) AS avg_sprint_distance,
    ROUND(AVG(CAST(pmv.value AS DECIMAL)) FILTER (WHERE pm.name = 'kpi_accelerationsRel'), 0) AS avg_accel,
    ROUND(AVG(CAST(pmv.value AS DECIMAL)) FILTER (WHERE pm.name = 'kpi_decelerationsRel'), 0) AS avg_decel,
    ROUND(MAX(CAST(pmv.value AS DECIMAL)) FILTER (WHERE pm.name = 'kpi_maxSpeed'), 1) AS max_speed, MAX(COALESCE((SELECT pmcu.unit FROM period_metric_club_units pmcu WHERE pmcu.metric_id = pm.id AND pmcu.club_id = a.club_id LIMIT 1), pm.unit)) AS unit
FROM period_metric_values pmv
  JOIN period_metrics pm ON pmv.metric_id = pm.id
  JOIN periods p ON pmv.period_id = p.id
  JOIN sport_activities sa ON p.sport_activity_id = sa.id
  JOIN days d ON sa.day_id = d.id
  JOIN athletes a ON d.athlete_id = a.id
  CROSS JOIN display_window dw
  WHERE a.club_id = '019fa7cc-684c-783e-9609-c132a26eb4e3'
    AND d.date_of_day BETWEEN dw.start_date AND dw.end_date
    AND pm.name IN ('kpi_distanceTotal', 'kpi_hmld', 'kpi_highSpeedRunningAbs', 'kpi_sprintDistance', 'kpi_accelerationsRel', 'kpi_decelerationsRel', 'kpi_maxSpeed')
    AND (
      p.name ILIKE '%entire session%'
      OR NOT EXISTS (
        SELECT 1 FROM periods p2
        WHERE p2.sport_activity_id = p.sport_activity_id AND p2.name ILIKE '%entire session%'
      )
    )
  GROUP BY a.id, joueur
  HAVING COUNT(DISTINCT d.date_of_day) >= 2
),
wellness_player AS (
  SELECT 
    a.id AS athlete_id,
    TRIM(a.first_name || ' ' || a.last_name) AS joueur,
    COUNT(DISTINCT d.date_of_day) AS n_wellness,
    ROUND(AVG(hr.body_soreness_rating), 1) AS avg_soreness,
    ROUND(AVG(hr.energy_rating), 1) AS avg_energy,
    ROUND(AVG(hr.mood_rating), 1) AS avg_mood
  FROM health_ratings hr
  JOIN days d ON hr.day_id = d.id
  JOIN athletes a ON d.athlete_id = a.id
  CROSS JOIN display_window dw
  WHERE a.club_id = '019fa7cc-684c-783e-9609-c132a26eb4e3'
    AND d.date_of_day BETWEEN dw.start_date AND dw.end_date
  GROUP BY a.id, joueur
),
sleep_player AS (
  SELECT 
    a.id AS athlete_id,
    TRIM(a.first_name || ' ' || a.last_name) AS joueur,
    COUNT(DISTINCT d.date_of_day) AS n_sleep,
    ROUND(AVG(s.quality_rating), 1) AS avg_sleep_quality,
    ROUND(AVG(s.sleep_efficiency_percentage), 1) AS avg_sleep_efficiency
  FROM sleeps s
  JOIN days d ON s.day_id = d.id
  JOIN athletes a ON d.athlete_id = a.id
  CROSS JOIN display_window dw
  WHERE a.club_id = '019fa7cc-684c-783e-9609-c132a26eb4e3'
    AND d.date_of_day BETWEEN dw.start_date AND dw.end_date
  GROUP BY a.id, joueur
)
SELECT 
  COALESCE(gp.joueur, wp.joueur, sp.joueur) AS joueur,
  gp.n_sessions,
  gp.avg_distance,
  gp.avg_hmld,
  gp.avg_hsr,
  gp.avg_sprint_distance,
  gp.avg_accel,
  gp.avg_decel,
  gp.max_speed,
  wp.n_wellness,
  wp.avg_soreness,
  wp.avg_energy,
  wp.avg_mood,
  sp.n_sleep,
  sp.avg_sleep_quality,
  sp.avg_sleep_efficiency
FROM gps_player gp
