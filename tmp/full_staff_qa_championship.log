premium  sql     │  WITH display_window AS (
  SELECT '2026-09-29'::date AS start_date, '2026-10-05'::date AS end_date
),
gps_daily AS (
  SELECT 
    d.date_of_day,
    a.id AS athlete_id,
    TRIM(a.first_name || ' ' || a.last_name) AS joueur,
    SUM(CAST(pmv.value AS DECIMAL)) FILTER (WHERE pm.name = 'kpi_distanceTotal') AS kpi_distancetotal,
    SUM(CAST(pmv.value AS DECIMAL)) FILTER (WHERE pm.name = 'kpi_hmld') AS kpi_hmld,
    SUM(CAST(pmv.value AS DECIMAL)) FILTER (WHERE pm.name = 'kpi_highSpeedRunningAbs') AS kpi_hsr,
    SUM(CAST(pmv.value AS DECIMAL)) FILTER (WHERE pm.name = 'kpi_sprintDistance') AS kpi_sprintdistance,
    SUM(CAST(pmv.value AS DECIMAL)) FILTER (WHERE pm.name = 'kpi_accelerationsRel') AS kpi_accelerationsrel,
    SUM(CAST(pmv.value AS DECIMAL)) FILTER (WHERE pm.name = 'kpi_decelerationsRel') AS kpi_decelerationsrel,
    SUM(CAST(pmv.value AS DECIMAL)) FILTER (WHERE pm.name = 'kpi_dsl') AS kpi_dsl, MAX(COALESCE((SELECT pmcu.unit FROM period_metric_club_units pmcu WHERE pmcu.metric_id = pm.id AND pmcu.club_id = a.club_id LIMIT 1), pm.unit)) AS unit
FROM period_metric_values pmv
  JOIN period_metrics pm ON pmv.metric_id = pm.id
  JOIN periods p ON pmv.period_id = p.id
  JOIN sport_activities sa ON p.sport_activity_id = sa.id
  JOIN days d ON sa.day_id = d.id
  JOIN athletes a ON d.athlete_id = a.id
  CROSS JOIN display_window dw
  WHERE a.club_id = '019fa7cc-684c-783e-9609-c132a26eb4e3'
    AND d.date_of_day BETWEEN dw.start_date AND dw.end_date
    AND pm.name IN ('kpi_distanceTotal', 'kpi_hmld', 'kpi_highSpeedRunningAbs', 'kpi_sprintDistance', 'kpi_accelerationsRel', 'kpi_decelerationsRel', 'kpi_dsl')
    AND (
      p.name ILIKE '%entire session%'
      OR NOT EXISTS (
        SELECT 1 FROM periods p2
        WHERE p2.sport_activity_id = p.sport_activity_id AND p2.name ILIKE '%entire session%'
      )
    )
  GROUP BY d.date_of_day, a.id, joueur
),
wellness_daily AS (
  SELECT 
    d.date_of_day,
    a.id AS athlete_id,
    TRIM(a.first_name || ' ' || a.last_name) AS joueur,
    hr.body_soreness_rating,
    hr.energy_rating,
    hr.mood_rating,
    hr.stress_rating
  FROM health_ratings hr
  JOIN days d ON hr.day_id = d.id
  JOIN athletes a ON d.athlete_id = a.id
  CROSS JOIN display_window dw
  WHERE a.club_id = '019fa7cc-684c-783e-9609-c132a26eb4e3'
    AND d.date_of_day BETWEEN dw.start_date AND dw.end_date
),
sleep_daily AS (
  SELECT 
    d.date_of_day,
    a.id AS athlete_id,
    TRIM(a.first_name || ' ' || a.last_name) AS joueur,
    s.quality_rating,
    s.sleep_efficiency_percentage,
    ROUND(s.total_in_bed_time_milli / 3600000.0, 1) AS hours_in_bed
  FROM sleeps s
  JOIN days d ON s.day_id = d.id
  JOIN athletes a ON d.athlete_id = a.id
  CROSS JOIN display_window dw
  WHERE a.club_id = '019fa7cc-684c-783e-9609-c132a26eb4e3'
    AND d.date_of_day BETWEEN dw.start_date AND dw.end_date
),
team_gps_daily AS (
  SELECT 
    date_of_day,
    COUNT(DISTINCT athlete_id) AS n,
    ROUND(AVG(kpi_distancetotal), 0) AS avg_distance,
    ROUND(AVG(kpi_hmld), 0) AS avg_hmld,
    ROUND(AVG(kpi_hsr), 0) AS avg_hsr,
    ROUND(AVG(kpi_sprintdistance), 0) AS avg_sprint_distance,
    ROUND(AVG(kpi_accelerationsrel), 0) AS avg_accel,
    ROUND(AVG(kpi_decelerationsrel), 0) AS avg_decel,
    ROUND(AVG(kpi_dsl), 1) AS avg_dsl
  FROM gps_daily
  GROUP BY date_of_day
),
team_wellness_daily AS (
  SELECT 
    date_of_day,
    COUNT(DISTINCT athlete_id) AS n,
    ROUND(AVG(body_soreness_rating), 1) AS avg_soreness,
    ROUND(AVG(energy_rating), 1) AS avg_energy,
    ROUND(AVG(mood_rating), 1) AS avg_mood,
    ROUND(AVG(stress_rating), 1) AS avg_stress
  FROM wellness_daily
  GROUP BY date_of_day
),
team_sleep_daily AS (
  SELECT 
    date_of_day,
    COUNT(DISTINCT athlete_id) AS n,
    ROUND(AVG(quality_rating), 1) AS avg_sleep_quality,
    ROUND(AVG(sleep_efficiency_percentage), 1) AS avg_sleep_efficiency,
    ROUND(AVG(hours_in_bed), 1) AS avg_hours_in_bed
  FROM sleep_daily
  GROUP BY date_of_day
)
SELECT 
  COALESCE(tg.date_of_day, tw.date_of_day, ts.date_of_day) AS date_of_day,
  tg.n AS n_gps,
  tg.avg_distance,
  tg.avg_hmld,
  tg.avg_hsr,
  tg.avg_sprint_distance,
  tg.avg_accel,
  tg.avg_decel,
  tg.avg_dsl,
  tw.n AS n_wellness,
  tw.avg_soreness,
  tw.avg_energy,
  tw.avg_mood,
  tw.avg_stress,
  ts.n AS n_sleep,
  ts.avg_sleep_quality,
  ts.avg_sleep_efficiency,
  ts.avg_hours_in_bed
FROM team_gps_daily tg
FULL OUTER JOIN team_wellness_daily tw ON tg.date_of_day = tw.date_of_day
FULL OUTER JOIN team_sleep_daily ts ON tg.date_of_day = ts.date_of_day
ORDER BY date_of_day - function round(double precision, integer) does not exist
